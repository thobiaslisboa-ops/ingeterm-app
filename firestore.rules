rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de usuarios: cualquier autenticado lee,
    // solo administradores escriben.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'administrador';
    }

    // Resto de colecciones: acceso completo con sesión activa.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
